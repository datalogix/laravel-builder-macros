{
    "name": "datalogix/laravel-builder-macros",
    "description": "A set of useful Laravel builder macros.",
    "keywords": [
        "laravel",
        "query",
        "sql",
        "builder",
        "macros"
    ],
    "homepage": "https://github.com/datalogix/laravel-builder-macros",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Ricardo Gobbo de Souza",
            "email": "ricardogobbosouza@yahoo.com.br"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.14",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.8|^4.7|^5.3",
        "phpunit/phpunit": "^11.5|^12.0|^13.0",
        "rector/rector": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "Datalogix\\BuilderMacros\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Datalogix\\BuilderMacros\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "lint": [
            "@php vendor/bin/pint --test",
            "@php vendor/bin/phpstan analyse --memory-limit=1G",
            "@php vendor/bin/rector --dry-run"
        ],
        "format": [
            "@php vendor/bin/rector",
            "@php vendor/bin/pint"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Datalogix\\BuilderMacros\\BuilderMacroServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
