{
    "name": "datalogix/laravel-builder-macros",
    "description": "A set of useful Laravel builder macros.",
    "keywords": [
        "laravel",
        "query",
        "sql",
        "builder",
        "macros"
    ],
    "homepage": "https://github.com/datalogix/laravel-builder-macros",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Ricardo Gobbo de Souza",
            "email": "ricardogobbosouza@yahoo.com.br"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "graham-campbell/testbench": "^6.3",
        "laravel/pint": "^1.30",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Datalogix\\BuilderMacros\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Datalogix\\BuilderMacros\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "vendor/bin/pint",
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Datalogix\\BuilderMacros\\BuilderMacroServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
